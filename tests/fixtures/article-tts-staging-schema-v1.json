  "constraints": [
    {
      "name": "newsletter_projects_article_tts_voice_allowed",
      "type": "c",
      "table": "newsletter_projects",
      "deferred": false,
      "deferrable": false,
      "definition": "CHECK (((article_tts_voice IS NULL) OR (article_tts_voice = ANY (ARRAY['marin'::text, 'cedar'::text, 'onyx'::text, 'coral'::text]))))"
    },
    {
      "name": "newsletter_projects_body_font_asset_id_fkey",
      "type": "f",
      "table": "newsletter_projects",
      "deferred": false,
      "deferrable": false,
      "definition": "FOREIGN KEY (body_font_asset_id) REFERENCES font_assets(id) ON DELETE SET NULL"
    },
    {
      "name": "newsletter_projects_client_review_recipient_email_check",
      "type": "c",
      "table": "newsletter_projects",
      "deferred": false,
      "deferrable": false,
      "definition": "CHECK (((client_review_recipient_email IS NULL) OR (((char_length(client_review_recipient_email) >= 3) AND (char_length(client_review_recipient_email) <= 254)) AND (client_review_recipient_email = btrim(client_review_recipient_email)))))"
    },
    {
      "name": "newsletter_projects_cloned_from_project_id_fkey",
      "type": "f",
      "table": "newsletter_projects",
      "deferred": false,
      "deferrable": false,
      "definition": "FOREIGN KEY (cloned_from_project_id) REFERENCES newsletter_projects(id) ON DELETE SET NULL"
    },
    {
      "name": "newsletter_projects_cover_fit_check",
      "type": "c",
      "table": "newsletter_projects",
      "deferred": false,
      "deferrable": false,
      "definition": "CHECK ((cover_fit = ANY (ARRAY['contain'::text, 'cover'::text])))"
    },
    {
      "name": "newsletter_projects_cover_layout_check",
      "type": "c",
      "table": "newsletter_projects",
      "deferred": false,
      "deferrable": false,
      "definition": "CHECK ((cover_layout = ANY (ARRAY['image'::text, 'image_info'::text, 'image_overlay'::text])))"
    },
