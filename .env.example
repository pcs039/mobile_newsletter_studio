NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Use only in server-only code after access policies are finalized.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only OpenAI settings. Never expose these with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_ARTICLE_MODEL=gpt-5.6-terra
# Optional. AI operations commentary falls back to OPENAI_ARTICLE_MODEL when omitted.
OPENAI_OPERATIONS_REPORT_MODEL=

# Server-only design processing credentials. Never expose these with a NEXT_PUBLIC_ prefix.
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Optional. Existing article/e-book TTS falls back to its built-in model when omitted.
OPENAI_TTS_MODEL=
# Fixed server-only callback registered in Canva Developer Portal.
# Staging uses a stable HTTPS deployment URL; never a production redirect for testing.
CANVA_REDIRECT_URI=
